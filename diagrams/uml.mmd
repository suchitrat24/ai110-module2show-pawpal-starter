classDiagram
    %% PawPal+ design. Keep this file updated so it matches your final implementation.

    class Task {
        +str description
        +str time
        +int duration_minutes
        +str priority
        +str frequency
        +bool completed
        +str pet_name
        +date due_date
        +mark_complete() None
        +mark_incomplete() None
        +priority_value() int
        +next_occurrence() Task
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(description: str) bool
        +get_tasks() list~Task~
    }

    class Owner {
        +str name
        +int available_minutes
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +get_pet(name: str) Pet
        +get_all_tasks() list~Task~
    }

    class Scheduler {
        +Owner owner
        +get_tasks() list~Task~
        +get_pending_tasks() list~Task~
        +sort_by_time(tasks) list~Task~
        +filter_tasks(pet_name, completed, tasks) list~Task~
        +filter_by_pet(pet_name: str) list~Task~
        +mark_task_complete(task: Task) Task
        +detect_conflicts(tasks) list~str~
        +todays_schedule(today) list~Task~
        +format_schedule() str
    }

    Owner "1" o-- "*" Pet : owns
    Pet "1" *-- "*" Task : needs
    Scheduler "1" --> "1" Owner : reads via get_all_tasks()
    Scheduler ..> Task : sorts, filters, completes
    Task ..> Task : next_occurrence()
